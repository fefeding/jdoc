{
  "name": "jdoc-viewer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.15",
  "keywords": [
    "docx",
    "xlsx",
    "pdf",
    "pptx",
    "markdown",
    "document",
    "viewer",
    "editor",
    "skills",
    "ai-agent"
  ],
  "publisher": "fefeding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fefeding/jdoc.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "contributes": {
    "customEditors": [
      {
        "viewType": "jdoc.documentEditor",
        "displayName": "%customEditor.documentEditor%",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.pdf"
          },
          {
            "filenamePattern": "*.txt"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "jdoc.revert",
        "title": "%command.revert%"
      },
      {
        "command": "jdoc.exportCopy",
        "title": "%command.exportCopy%"
      },
      {
        "command": "jdoc.preview",
        "title": "%command.preview%"
      },
      {
        "command": "jdoc.viewMode",
        "title": "%command.viewMode%",
        "category": "jdoc",
        "icon": "$(preview)"
      },
      {
        "command": "jdoc.editMode",
        "title": "%command.editMode%",
        "category": "jdoc",
        "icon": "$(edit)"
      },
      {
        "command": "jdoc.switchDocument",
        "title": "%command.switchDocument%",
        "category": "jdoc",
        "icon": "$(files)"
      },
      {
        "command": "jdoc.convert",
        "title": "%command.convert%",
        "category": "jdoc",
        "icon": "$(arrow-swap)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jdoc.revert",
          "when": "activeCustomEditor == 'jdoc.documentEditor'"
        },
        {
          "command": "jdoc.exportCopy",
          "when": "activeCustomEditor == 'jdoc.documentEditor'"
        },
        {
          "command": "jdoc.switchDocument",
          "when": "activeCustomEditor == 'jdoc.documentEditor'"
        }
      ],
      "editor/title": [
        {
          "command": "jdoc.convert",
          "when": "activeCustomEditor == 'jdoc.documentEditor' && resourceExtname =~ /\\.(docx|xlsx|pptx|pdf|md|markdown|html|htm|txt)$/",
          "group": "navigation@1"
        },
        {
          "command": "jdoc.switchDocument",
          "when": "activeCustomEditor == 'jdoc.documentEditor'",
          "group": "navigation@2"
        },
        {
          "command": "jdoc.viewMode",
          "when": "activeCustomEditor == 'jdoc.documentEditor' && resourceExtname =~ /\\.(pptx|docx|xlsx)$/ && !jdoc:editing",
          "group": "navigation@3"
        },
        {
          "command": "jdoc.editMode",
          "when": "activeCustomEditor == 'jdoc.documentEditor' && resourceExtname =~ /\\.(pptx|docx|xlsx)$/ && jdoc:editing",
          "group": "navigation@3"
        },
        {
          "command": "jdoc.revert",
          "when": "activeCustomEditor == 'jdoc.documentEditor' && resourceExtname =~ /\\.(docx|pptx|xlsx)$/",
          "group": "1_modification"
        },
        {
          "command": "jdoc.exportCopy",
          "when": "activeCustomEditor == 'jdoc.documentEditor'",
          "group": "1_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "jdoc.convert",
          "when": "resourceExtname =~ /\\.(docx|xlsx|pptx|pdf|md|markdown|html|htm|txt)$/",
          "group": "navigation@1"
        },
        {
          "command": "jdoc.preview",
          "when": "activeCustomEditor != 'jdoc.documentEditor' && resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "jdoc.preview",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "jdoc.preview",
          "when": "activeCustomEditor != 'jdoc.documentEditor' && resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation@1"
        },
        {
          "command": "jdoc.convert",
          "when": "resourceExtname =~ /\\.(docx|xlsx|pptx|pdf|md|markdown|html|htm|txt)$/",
          "group": "navigation@2"
        },
        {
          "command": "jdoc.viewMode",
          "when": "activeCustomEditor == 'jdoc.documentEditor' && resourceExtname =~ /\\.(pptx|docx|xlsx)$/ && !jdoc:editing",
          "group": "navigation@3"
        },
        {
          "command": "jdoc.editMode",
          "when": "activeCustomEditor == 'jdoc.documentEditor' && resourceExtname =~ /\\.(pptx|docx|xlsx)$/ && jdoc:editing",
          "group": "navigation@3"
        },
        {
          "command": "jdoc.switchDocument",
          "when": "activeCustomEditor == 'jdoc.documentEditor'",
          "group": "navigation@4"
        },
        {
          "command": "jdoc.revert",
          "when": "activeCustomEditor == 'jdoc.documentEditor' && resourceExtname =~ /\\.(docx|pptx|xlsx)$/",
          "group": "1_modification"
        },
        {
          "command": "jdoc.exportCopy",
          "when": "activeCustomEditor == 'jdoc.documentEditor'",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "dev": "node esbuild.js --watch",
    "verify:roundtrip": "node scripts/verify-roundtrip.mjs",
    "verify:xlsx": "node scripts/verify-xlsx.mjs",
    "verify:convert": "node scripts/verify-convert-formats.mjs",
    "sync:md-assets": "node -e \"const fs=require('fs'),p=require('path');const src=p.resolve(__dirname,'..','node_modules','katex','dist'),dst=p.resolve(__dirname,'media');fs.copyFileSync(p.join(src,'katex.min.css'),p.join(dst,'katex.min.css'));fs.rmSync(p.join(dst,'fonts'),{recursive:true,force:true});fs.cpSync(p.join(src,'fonts'),p.join(dst,'fonts'),{recursive:true})\"",
    "install:jdoc": "npm install file:..",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@fefeding/jdoc": "file:..",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.75.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.23.1",
    "highlight.js": "^11.12.0",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
