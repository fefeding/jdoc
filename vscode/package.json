{
  "name": "jdoc-viewer",
  "displayName": "jdoc Document Viewer",
  "description": "在 VS Code 中查看并编辑 PPTX / DOCX / XLSX / PDF 文档，并预览 Markdown / 纯文本（由 @fefeding/jdoc 驱动）",
  "version": "0.1.1",
  "keywords": [
    "docx",
    "xlsx",
    "pdf",
    "pptx",
    "markdown",
    "document",
    "viewer",
    "editor",
    "skills",
    "ai-agent"
  ],
  "publisher": "fefeding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fefeding/jdoc.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "contributes": {
    "customEditors": [
      {
        "viewType": "jdoc.documentEditor",
        "displayName": "jdoc Document Editor",
        "selector": [
          { "filenamePattern": "*.pptx" },
          { "filenamePattern": "*.docx" },
          { "filenamePattern": "*.xlsx" },
          { "filenamePattern": "*.pdf" },
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" },
          { "filenamePattern": "*.txt" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "jdoc.revert",
        "title": "Revert"
      },
      {
        "command": "jdoc.exportCopy",
        "title": "Export Copy"
      },
      {
        "command": "jdoc.preview",
        "title": "jdoc: 用 jdoc 打开预览"
      },
      {
        "command": "jdoc.viewMode",
        "title": "查看",
        "category": "jdoc",
        "icon": "$(preview)"
      },
      {
        "command": "jdoc.editMode",
        "title": "编辑",
        "category": "jdoc",
        "icon": "$(edit)"
      },
      {
        "command": "jdoc.switchDocument",
        "title": "切换文档",
        "category": "jdoc",
        "icon": "$(files)"
      },
      {
        "command": "jdoc.convert",
        "title": "转换格式为…",
        "category": "jdoc",
        "icon": "$(arrow-swap)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jdoc.viewMode",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx)$/ && !jdoc:editing",
          "group": "navigation@1"
        },
        {
          "command": "jdoc.editMode",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx)$/ && jdoc:editing",
          "group": "navigation@1"
        },
        {
          "command": "jdoc.switchDocument",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation@2"
        },
        {
          "command": "jdoc.revert",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation"
        },
        {
          "command": "jdoc.exportCopy",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation"
        },
        {
          "command": "jdoc.convert",
          "when": "resourceExtname =~ /\\.(docx|pdf|md|markdown|html|htm|txt)$/",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "jdoc.preview",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation"
        },
        {
          "command": "jdoc.convert",
          "when": "resourceExtname =~ /\\.(docx|pdf|md|markdown|html|htm|txt)$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "jdoc.preview",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "dev": "node esbuild.js --watch",
    "verify:roundtrip": "node scripts/verify-roundtrip.mjs",
    "sync:md-assets": "node -e \"const fs=require('fs'),p=require('path');const src=p.resolve(__dirname,'..','node_modules','katex','dist'),dst=p.resolve(__dirname,'media');fs.copyFileSync(p.join(src,'katex.min.css'),p.join(dst,'katex.min.css'));fs.rmSync(p.join(dst,'fonts'),{recursive:true,force:true});fs.cpSync(p.join(src,'fonts'),p.join(dst,'fonts'),{recursive:true})\"",    "install:jdoc": "npm install file:..",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@fefeding/jdoc": "file:..",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.75.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.23.1",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
