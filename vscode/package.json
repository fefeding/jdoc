{
  "name": "jdoc-viewer",
  "displayName": "jdoc Document Viewer",
  "description": "在 VS Code 中查看并编辑 PPTX / DOCX / XLSX / PDF 文档，并预览 Markdown / 纯文本（由 @fefeding/jdoc 驱动）",
  "version": "0.1.1",
  "publisher": "fefeding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fefeding/jdoc.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "activationEvents": [
    "onCustomEditor:jdoc.documentEditor",
    "onCommand:jdoc.preview"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "jdoc.documentEditor",
        "displayName": "jdoc Document Editor",
        "selector": [
          { "filenamePattern": "*.pptx" },
          { "filenamePattern": "*.docx" },
          { "filenamePattern": "*.xlsx" },
          { "filenamePattern": "*.pdf" },
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" },
          { "filenamePattern": "*.txt" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "jdoc.revert",
        "title": "Revert"
      },
      {
        "command": "jdoc.exportCopy",
        "title": "Export Copy"
      },
      {
        "command": "jdoc.preview",
        "title": "jdoc: 用 jdoc 打开预览"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jdoc.revert",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation"
        },
        {
          "command": "jdoc.exportCopy",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "jdoc.preview",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "jdoc.preview",
          "when": "resourceExtname =~ /\\.(pptx|docx|xlsx|pdf|md|markdown|txt)$/",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "dev": "node esbuild.js --watch",
    "verify:roundtrip": "node scripts/verify-roundtrip.mjs",
    "sync:pdf-worker": "node -e \"const fs=require('fs'),p=require('path');fs.copyFileSync(p.resolve(__dirname,'..','node_modules','pdfjs-dist','legacy','build','pdf.worker.min.mjs'),p.resolve(__dirname,'media','pdf.worker.min.mjs'))\"",
    "install:jdoc": "npm install file:..",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@fefeding/jdoc": "file:..",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.75.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.23.1",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
