{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vscode"],
    "baseUrl": ".",
    "paths": {
      "@fefeding/jdoc": ["../dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
